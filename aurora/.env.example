# Copy this file to .env.local and fill in real values.
#
# Aurora uses two secrets in dev:
#   - AUTH_SECRET: signs your login session cookie. Generate one with:
#       openssl rand -base64 32
#   - ANTHROPIC_API_KEY: powers Claude dream interpretation.
#       Get one at https://console.anthropic.com/
#
# DATABASE_URL lives in the committed .env (it's just a SQLite file path).
# To switch to Postgres for production, override DATABASE_URL here.

AUTH_SECRET=replace-with-output-of-openssl-rand-base64-32
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the DB to use Postgres (e.g. Neon) instead of SQLite.
# DATABASE_URL=postgres://user:pass@host/db
