# Copy this file to .env.local and fill in real values.
#
# Aurora needs three secrets to run:
#
#   DATABASE_URL — Postgres connection string. Easiest: create a free
#     project at https://neon.tech/ and copy the "Pooled connection" URL.
#     Format: postgresql://user:pass@host/db?sslmode=require
#
#   AUTH_SECRET — signs your login session cookie. Generate with:
#       openssl rand -base64 32
#
#   ANTHROPIC_API_KEY — powers Claude dream interpretation + threads.
#     Get one at https://console.anthropic.com/

DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
AUTH_SECRET=replace-with-output-of-openssl-rand-base64-32
ANTHROPIC_API_KEY=sk-ant-...
