# --- Backend ---
DATABASE_URL=postgresql+psycopg://atlas:atlas@postgres:5432/atlas
REDIS_URL=redis://redis:6379/0

# Market data: "mock" (default, no creds) or "mt5"
MARKET_ADAPTER=mock

# MT5 credentials (only required when MARKET_ADAPTER=mt5)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Instruments
SYMBOL_US100=NAS100
SYMBOL_SPX=SPX500

# Risk defaults
ACCOUNT_EQUITY=100000
RISK_PER_TRADE_PCT=0.5
MIN_CONFIDENCE=0.60
MIN_EXPECTANCY_R=0.10

# Signal loop
SIGNAL_INTERVAL_SEC=2

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/signals
